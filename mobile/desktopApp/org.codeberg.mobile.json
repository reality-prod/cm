{
  "app-id": "org.codeberg.mobile",
  "runtime": "org.freedesktop.Platform",
  "runtime-version": "26.08",
  "sdk": "org.freedesktop.Sdk",
  "sdk-extensions": [
    "org.freedesktop.Sdk.Extension.openjdk17"
  ],
  "command": "codeberg-mobile",
  "finish-args": [
    "--share=ipc",
    "--socket=x11",
    "--socket=wayland",
    "--socket=pulseaudio",
    "--share=network",
    "--device=dri"
  ],
  "modules": [
    {
      "name": "codeberg-mobile",
      "buildsystem": "simple",
      "build-options": {
        "append-path": "/usr/lib/sdk/openjdk17/bin",
        "env": {
          "JAVA_HOME": "/usr/lib/sdk/openjdk17"
        },
        "build-args": [
          "--share=network"
        ]
      },
      "build-commands": [
        "./gradlew :desktopApp:createDistributable --no-daemon",
        
        "mkdir -p /app/bin",
        "mkdir -p /app/share/applications",
        "mkdir -p /app/share/icons/hicolor/512x512/apps",
        
        "cp -r desktopApp/build/compose/binaries/main/app/codeberg-mobile/* /app/",
        
        "cp desktopApp/src/jvmMain/resources/app_icon.png /app/share/icons/hicolor/512x512/apps/org.codeberg.mobile.png",
        
        "echo '[Desktop Entry]' > /app/share/applications/org.codeberg.mobile.desktop",
        "echo 'Name=Codeberg Mobile' >> /app/share/applications/org.codeberg.mobile.desktop",
        "echo 'Comment=Mobile Client for Codeberg' >> /app/share/applications/org.codeberg.mobile.desktop",
        "echo 'Exec=codeberg-mobile' >> /app/share/applications/org.codeberg.mobile.desktop",
        "echo 'Icon=org.codeberg.mobile' >> /app/share/applications/org.codeberg.mobile.desktop",
        "echo 'Type=Application' >> /app/share/applications/org.codeberg.mobile.desktop",
        "echo 'Terminal=false' >> /app/share/applications/org.codeberg.mobile.desktop",
        "echo 'Categories=Network;Development;' >> /app/share/applications/org.codeberg.mobile.desktop",
        "echo 'X-Purism-FormFactor=Workstation;Mobile;' >> /app/share/applications/org.codeberg.mobile.desktop"
      ],
      "sources": [
        {
          "type": "git",
          "url": "https://github.com/reality-prod/cm",
          "branch": "main"
        },
        "gradle-dependencies.json"
      ]
    }
  ]
}
